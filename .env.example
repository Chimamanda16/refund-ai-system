# ---------------------------------------------------------------
# Copy to `.env` and adjust
# `docker compose up` works without a .env file (dev defaults are
# built into docker-compose.yml); create one to override them.
# ---------------------------------------------------------------

# --- PostgreSQL container (used by docker-compose.yml) ---
POSTGRES_USER=refund_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=refund_ai
POSTGRES_PORT=5432

# --- Backend ---
# Local (non-Docker) connection string. Inside Docker Compose this is
# built automatically and points at the `postgres` service.
DATABASE_URL=postgresql://refund_admin:change_me_locally@localhost:5432/refund_ai
# Not used until the LLM phase. Server-side only, never exposed to the frontend
PORT=4000
# Allowed browser origin(s) for CORS. Comma-separate for several.
CLIENT_URL=http://localhost:5173
# Seed the database automatically on startup if it is empty (true/false).
AUTO_SEED=true

# --- Frontend (only VITE_-prefixed variables reach the browser) ---
VITE_API_URL=http://localhost:4000/api
